# Only the eval harness (evals/) needs these; the MCP server itself runs without them.
# OpenAI-compatible endpoint, e.g. Ollama Cloud
LLM_BASE_URL=https://ollama.com/v1
# API key for that endpoint (secret: keep it in .env, which is git-ignored)
LLM_API_KEY=
# Model used by the benchmark agent (and by default by the judge; see evals/judge.yaml)
LLM_MODEL=beam:cloud
# Optional: a different agent model for harvesting failure traces
EVAL_AGENT_MODEL=
