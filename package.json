{
  "name": "financial-indicators-mcp",
  "version": "1.0.0",
  "description": "Financial Indicators MCP Server",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "eval:fetch": "npm run build && node dist/evals/fetch-assets.js",
    "eval:run": "npm run build && node dist/evals/run-benchmark.js",
    "eval:l1": "npm run build && node dist/evals/level1.js",
    "eval:judge": "npm run build && node dist/evals/run-judge.js",
    "eval:label": "npm run build && node dist/evals/label.js",
    "eval:calibrate": "npm run build && node dist/evals/judge-calibration.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "ccxt": "^4.2.0",
    "simple-statistics": "^7.8.9",
    "skia-canvas": "^3.0.8",
    "technicalindicators": "^3.1.0",
    "yahoo-finance2": "^3.14.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "yaml": "^2.9.1"
  }
}
